---
import Layout from "../layouts/Layout.astro";

const formationSections = [
  {
    title: "Gestion des stages",
    skills: ["B1.1", "B1.4", "B1.5"],
    summary: "Application Symfony pour centraliser, suivre et historiser les stages.",
    links: [{ label: "Application de gestion des stages", href: "/rp/tp/gestion-stages" }],
  },
  {
    title: "Gestion de voyages",
    skills: ["B1.1", "B1.4", "B1.5"],
    summary: "Application Windows MAUI C# pour gérer les trajets et les voyages.",
    links: [{ label: "Application de gestion de voyage", href: "/rp/tp/gestion-voyage" }],
  },
  {
    title: "Site Cybernews",
    skills: ["B1.3", "B1.6"],
    summary: "Présence en ligne et diffusion régulière autour de la cybersécurité.",
    links: [{ label: "Cybernews dynamique + BD", href: "/rp/tp/cybernews-bd" }],
  },
  {
    title: "Gestion des utilisateurs SQL",
    skills: ["B1.1"],
    summary: "Gestion des droits et des habilitations avec SQL.",
    links: [{ label: "Gestion utilisateurs & droits SQL", href: "/rp/tp/gestion-utilisateurs-sql" }],
  },
  {
    title: "GLPI",
    skills: ["B1.2"],
    summary: "Mise en place d'un outil de support pour incidents et demandes.",
    links: [{ label: "Installation GLPI + tickets", href: "/rp/tp/glpi-tickets" }],
  },
  {
    title: "GSK",
    skills: ["B1.2", "B1.4"],
    summary: "Analyse des besoins et recommandations matérielles et logicielles.",
    links: [{ label: "Projet GSK: analyse besoins & recommandations", href: "/rp/tp/gsk" }],
  },
  {
    title: "Site web en équipe",
    skills: ["B1.3", "B1.4", "B1.5"],
    summary: "Travail collaboratif, planification, évolution dynamique, mise en ligne et suivi de projet.",
    links: [{ label: "Site d'équipe (recensement, dynamique, ligne, Trello)", href: "/rp/tp/site-equipe" }],
  },
  {
    title: "Normes SQL",
    skills: ["B1.1"],
    summary: "Bonnes pratiques SQL, structure du code et contrôle de conformité.",
    links: [
      { label: "Normes SQL & bonnes pratiques", href: "/rp/tp/norme-sql" },
      { label: "Validation W3C pages HTML/CSS", href: "/rp/tp/validation-w3c" },
      { label: "Structuration sémantique & accessibilité", href: "/rp/tp/structuration-semantique" },
      { label: "Morpion console C#", href: "/rp/tp/morpion-csharp" },
    ],
  },
  {
    title: "Portfolio",
    skills: ["B1.5", "B1.6"],
    summary: "Mise à disposition en ligne et valorisation du parcours.",
    links: [{ label: "Portfolio BTS SIO - Développement avec Astro", href: "/rp/tp/portfolio" }],
  },
  {
    title: "LinkedIn et développement pro",
    skills: ["B1.6"],
    summary: "Présence professionnelle, veille, certifications et projection métier.",
    links: [
      { label: "Profil LinkedIn", href: "/rp/tp/linkedin" },
      { label: "Score Pix", href: "/rp/tp/pix" },
      { label: "MOOC ANSSI", href: "/rp/tp/mooc-anssi" },
      { label: "Certifications RGPD", href: "/rp/tp/rgpd" },
      { label: "Étude référentiel & fiche métier", href: "/rp/tp/etude-referentiel" },
      { label: "Analyse sanctions d'entreprise", href: "/rp/tp/analyse-sanctions" },
    ],
  },
  {
    title: "Veille technologique",
    skills: ["B1.6"],
    summary: "Recherche, synthèse et diffusion d'informations techniques.",
    links: [{ label: "Veille techno (synthèses mensuelles)", href: "/rp/tp/veille-techno" }],
  },
];

const stage1Section = {
  title: "Stage 1",
  skills: ["B1.1", "B1.3", "B1.4", "B1.6"],
  summary: "Découverte du contexte pro avec un site vitrine et du travail structuré en équipe.",
  href: "/rp/stage-1",
  highlights: ["Application vitrine", "Formulaire serveur", "Organisation du projet"],
};

const stage2Section = {
  title: "Stage 2",
  skills: ["B1.1", "B1.2", "B1.3", "B1.4", "B1.6"],
  summary: "Montée en autonomie sur une API Symfony avec cache, pagination et sérialisation.",
  href: "/rp/stage-2",
  highlights: ["API produits", "Cache applicatif", "Tests Postman"],
};

const competenceSections = [
  {
    code: "B1.1",
    title: "Gérer le patrimoine informatique",
    description:
      "Recenser et identifier les ressources numériques, exploiter des référentiels, normes et standards adoptés par le prestataire informatique, mettre en place et vérifier les niveaux d'habilitation associés à un service, vérifier les conditions de la continuité d'un service informatique, gérer des sauvegardes, vérifier le respect des règles d'utilisation des ressources numériques.",
  },
  {
    code: "B1.2",
    title: "Répondre aux incidents et aux demandes d'assistance et d'évolution",
    description: "Collecter, suivre et orienter des demandes, traiter des demandes concernant les services réseau et système, applicatifs, traiter des demandes concernant les applications.",
  },
  {
    code: "B1.3",
    title: "Développer la présence en ligne de l'organisation",
    description:
      "Participer à la valorisation de l'image de l'organisation sur les médias numériques en tenant compte du cadre juridique et des enjeux économiques, référencer les services en ligne de l'organisation et mesurer leur visibilité, participer à l'évolution d'un site Web exploitant les données de l'organisation.",
  },
  {
    code: "B1.4",
    title: "Travailler en mode projet",
    description: "Analyser les objectifs et les modalités d'organisation d'un projet, planifier les activités, évaluer les indicateurs de suivi d'un projet et analyser les écarts.",
  },
  {
    code: "B1.5",
    title: "Mettre à disposition des utilisateurs un service informatique",
    description: "Réaliser les tests d'intégration et d'acceptation d'un service, déployer un service, accompagner les utilisateurs dans la mise en place d'un service.",
  },
  {
    code: "B1.6",
    title: "Organiser son développement professionnel",
    description:
      "Mettre en place son environnement d'apprentissage personnel, mettre en œuvre des outils et stratégies de veille informationnelle, gérer son identité professionnelle, développer son projet professionnel.",
  },
];
---

<Layout>
  <main class="rp-page">
    <section class="hero">
      <p class="eyebrow">Réalisations professionnelles</p>
      <h1>RP organisées par thème</h1>
    </section>

    <section class="section-block">
      <h2>Compétences BTS SIO</h2>
      <div class="competence-grid">
        {
          competenceSections.map((competence) => (
            <article class="competence-card">
              <div class="topic-head">
                <h3>
                  {competence.code} - {competence.title}
                </h3>
              </div>
              <p class="summary">{competence.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-block">
      <h2>Formation</h2>
      <div class="section-grid">
        {
          formationSections.map((section) => (
            <article class="topic-card">
              <div class="topic-head">
                <h3>{section.title}</h3>
                <p class="skill-list">{section.skills.join(", ")}</p>
              </div>
              <p class="summary">{section.summary}</p>
              <ul class="topic-links">
                {section.links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section-block">
      <h2>Stage 1</h2>
      <div class="section-grid stage-grid">
        <article class="stage-card">
          <div class="topic-head">
            <h3>{stage1Section.title}</h3>
            <p class="skill-list">{stage1Section.skills.join(", ")}</p>
          </div>
          <p class="summary">{stage1Section.summary}</p>
          <ul class="pill-list">
            {stage1Section.highlights.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn" href={stage1Section.href}>Voir le rapport</a>
        </article>
      </div>
    </section>

    <section class="section-block">
      <h2>Stage 2</h2>
      <div class="section-grid stage-grid">
        <article class="stage-card">
          <div class="topic-head">
            <h3>{stage2Section.title}</h3>
            <p class="skill-list">{stage2Section.skills.join(", ")}</p>
          </div>
          <p class="summary">{stage2Section.summary}</p>
          <ul class="pill-list">
            {stage2Section.highlights.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn" href={stage2Section.href}>Voir le rapport</a>
        </article>
      </div>
    </section>
  </main>
</Layout>

<style>
  .rp-page {
    max-width: 1180px;
    margin: 2rem auto 4rem;
    padding: 0 1rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.4rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.76rem;
    color: #6b7280;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
  }

  .intro {
    max-width: 760px;
    margin: 0.75rem auto 0;
    color: #4b5563;
    line-height: 1.6;
  }

  .section-block + .section-block {
    margin-top: 2rem;
  }

  .section-block > h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 1.6vw, 1.6rem);
  }

  .section-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .competence-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .topic-card,
  .competence-card,
  .stage-card {
    border: 1px solid #e5e7eb;
    border-radius: 18px;
    background: #fff;
    padding: 1.15rem;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
  }

  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .topic-head h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .skill-list {
    margin: 0;
    font-size: 0.84rem;
    color: #6b7280;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
  }

  .summary {
    margin: 0.75rem 0 0.9rem;
    color: #374151;
    line-height: 1.55;
  }

  .topic-links {
    margin: 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.45rem;
  }

  .topic-links a {
    color: #0f172a;
    text-decoration: none;
    border-bottom: 1px dotted #cbd5e1;
  }

  .topic-links a:hover {
    border-bottom-style: solid;
  }

  .stage-grid {
    grid-template-columns: 1fr;
  }

  .pill-list {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill-list li {
    background: #f3f4f6;
    color: #374151;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    padding: 0.35rem 0.6rem;
    font-size: 0.82rem;
  }

  .btn {
    display: inline-block;
    background: #111827;
    color: #fff;
    text-decoration: none;
    padding: 0.55rem 0.9rem;
    border-radius: 10px;
    font-size: 0.9rem;
  }

  .btn:hover {
    background: #0b1220;
  }

  @media (max-width: 900px) {
    .section-grid {
      grid-template-columns: 1fr;
    }

    .competence-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
